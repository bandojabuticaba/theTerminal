<?xml version="1.0" encoding="utf-8"?>
<!--
  The terminal's font. Baked at the size it's shown when the monitor's screen
  fills the view (terminal mode), so it's never scaled up - only down while
  zoomed out. Swap the font here and the terminal follows.
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>JetBrainsMono-Regular.ttf</FontName>
    <Size>20</Size>
    <Spacing>0</Spacing>
    <UseKerning>false</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
